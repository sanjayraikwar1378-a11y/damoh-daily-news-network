# ==========================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# ==========================================

# 1. MANDATORY: FIREBASE CONFIGURATION (For Live Database & Auth)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web App
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="damoh-daily-news.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="damoh-daily-news"
VITE_FIREBASE_STORAGE_BUCKET="damoh-daily-news.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"

# 2. MANDATORY: CLOUDINARY MEDIA CONFIGURATION (For Image & Video Uploads)
# Obtain from Cloudinary Dashboard -> Account Details
VITE_CLOUDINARY_CLOUD_NAME="damoh-daily-news"
VITE_CLOUDINARY_UPLOAD_PRESET="ml_default" # Cloudinary Upload Preset (Set to Unsigned in Cloudinary Console)

# 3. OPTIONAL: CLOUDINARY SIGNED UPLOADS (Only if using Signed upload presets)
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 4. OPTIONAL: GEMINI AI API KEY (For AI news assistance)
GEMINI_API_KEY="your-gemini-api-key"

# 5. FIREBASE CLOUD MESSAGING (FCM HTTP v1) PUSH NOTIFICATIONS
# Web Push VAPID Key (Public Key Pair only - for client getToken): Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY="your-firebase-web-push-vapid-key"
# Server-side Firebase Service Account JSON (For FCM HTTP v1): Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"damoh-daily-news","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
