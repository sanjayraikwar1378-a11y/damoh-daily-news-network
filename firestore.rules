rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@damohdaily\\.com$') ||
          request.auth.token.email.matches('.*@damohdailynews\\.com$') ||
          request.auth.token.email == 'sanjayraikwar1378@gmail.com'
        ))
      );
    }

    match /articles/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reporters/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comments/{document} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['articleId', 'userName', 'content']) &&
                       request.resource.data.articleId is string &&
                       request.resource.data.userName is string &&
                       request.resource.data.userName.size() > 0 &&
                       request.resource.data.userName.size() <= 100 &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() > 0 &&
                       request.resource.data.content.size() <= 2000 &&
                       (request.resource.data.status == 'pending' || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ads/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{document} {
      allow read: if isAdmin();
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 100;
      allow update, delete: if isAdmin();
    }

    match /live_updates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcm_tokens/{document} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.token is string &&
                               request.resource.data.token.size() >= 10 &&
                               request.resource.data.token.size() <= 500 &&
                               (request.resource.data.platform in ['web', 'android', 'ios', 'unknown']) &&
                               (request.resource.data.active is bool);
      allow delete: if isAdmin();
    }

    // Connection health check
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics & Events: Public users can record background view/like events, but ONLY authenticated admins can read/list/manage analytics data
    match /analytics_events/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /analytics/{document} {
      allow read, write: if isAdmin();
    }
  }
}
